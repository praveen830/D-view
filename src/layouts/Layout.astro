---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  cityName?: string;
  ogImage?: string;
  keywords?: string[];
  hideFloatingButtons?: boolean;
}

const {
  title,
  description,
  canonicalUrl = 'https://dviewsolutions.com',
  cityName = 'Andhra Pradesh',
  ogImage = '/assets/locations/visakhapatnam.png',
  keywords = ['invisible grills andhra pradesh', 'balcony safety solutions', 'ss 316 invisible grills', 'coastal balcony safety'],
  hideFloatingButtons = false
} = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "D-View Invisible Safety Grills",
  "image": "https://dviewsolutions.com/assets/locations/rajahmundry.png",
  "telephone": "+919494328999",
  "email": "contact@dviewsolutions.com",
  "url": "https://dviewsolutions.com",
  "priceRange": "₹₹",
  "areaServed": [
    {
      "@type": "City",
      "name": "Visakhapatnam"
    },
    {
      "@type": "City",
      "name": "Rajamahendravaram"
    },
    {
      "@type": "City",
      "name": "Vijayawada"
    },
    {
      "@type": "City",
      "name": "Guntur"
    },
    {
      "@type": "City",
      "name": "Kakinada"
    },
    {
      "@type": "City",
      "name": "Nellore"
    }
  ],
  "description": "Architectural high-tensile SS-316 invisible safety grills for luxury apartments, balcony child fall safety, pet security, and pigeon control with 10-year warranty."
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="bg-[#0B0D0C] text-[#F8FAFC] antialiased selection:bg-[#7CFF3A] selection:text-[#0B0D0C]">
    <slot />

    {!hideFloatingButtons && (
      <>
        <!-- Floating Direct Call Button (Bottom Left) -->
        <a
          href="tel:+919494328999"
          aria-label="Direct Call Helpline"
          class="fixed bottom-6 left-6 z-50 w-12 h-12 rounded-full bg-[#121816]/90 hover:bg-[#1A2420] border-2 border-[#24322B] hover:border-[#7CFF3A] text-white hover:text-[#7CFF3A] flex items-center justify-center shadow-2xl backdrop-blur-md transition-all hover:scale-110 active:scale-95 group"
        >
          <svg class="w-5 h-5 text-[#7CFF3A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="absolute left-14 bg-[#121816] text-[#C7CDD1] text-xs font-semibold px-3 py-1.5 rounded-lg border border-[#24322B] shadow-xl whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
            Call: +91 94943 28999
          </span>
        </a>

        <!-- Floating WhatsApp Quick Connect (Bottom Right) -->
        <a
          href="https://wa.me/919494328999?text=Hello%20D-VIEW%20Solutions!%20I%20would%20like%20to%20know%20more%20about%20Invisible%20Grills%20and%20schedule%20a%20free%20measurement."
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Chat on WhatsApp"
          class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-white flex items-center justify-center shadow-[0_0_25px_rgba(37,211,102,0.4)] transition-all hover:scale-110 active:scale-95 group"
        >
          <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.158.57 4.187 1.564 5.945l-1.633 5.966 6.136-1.61c1.704.935 3.659 1.469 5.733 1.469 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z" />
          </svg>
          <span class="absolute right-16 bg-[#121816] text-white text-xs font-semibold px-3 py-1.5 rounded-lg border border-[#24322B] shadow-xl whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
            Chat on WhatsApp
          </span>
          <span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-[#7CFF3A] rounded-full border-2 border-[#0B0D0C] animate-ping"></span>
        </a>
      </>
    )}
  </body>
</html>
