---
---

<section class="py-16 sm:py-20 bg-[#0B0D0C] border-t border-[#24322B] relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Formula Card matching Reference Image 5 */}
    <div class="relative bg-[#0F1412] rounded-3xl border-2 border-[#7CFF3A] p-6 sm:p-10 shadow-[0_0_50px_rgba(124,255,58,0.2)]">
      
      {/* Centered Top Badge: OUR FORMULA */}
      <div class="absolute -top-6 left-1/2 -translate-x-1/2">
        <div class="px-8 py-2 rounded-full bg-gradient-to-r from-[#7CFF3A] to-[#16A34A] text-[#0B0D0C] font-black text-sm sm:text-base tracking-wider uppercase shadow-[0_0_25px_rgba(124,255,58,0.6)]">
          OUR FORMULA
        </div>
      </div>

      {/* Grid of Steps */}
      <div class="pt-4 flex flex-col lg:flex-row items-center justify-between gap-4 lg:gap-2">
        
        {/* Step 1: PROBLEM */}
        <div class="flex-1 text-center w-full">
          <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto rounded-2xl bg-[#151C19] border border-[#24322B] flex items-center justify-center text-white mb-3">
            <svg class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 8a2 2 0 100-4 2 2 0 000 4z" />
            </svg>
          </div>
          <h4 class="text-sm sm:text-base font-black text-white uppercase tracking-wider">
            PROBLEM
          </h4>
          <span class="block text-xs text-[#94A3B8] mt-0.5">
            (Your Safety Concern)
          </span>
        </div>

        {/* Plus Symbol */}
        <div class="text-[#7CFF3A] font-black text-2xl lg:text-3xl shrink-0 select-none">
          +
        </div>

        {/* Step 2: EXPLAIN */}
        <div class="flex-1 text-center w-full">
          <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto rounded-2xl bg-[#151C19] border border-[#24322B] flex items-center justify-center text-[#7CFF3A] mb-3">
            <svg class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h4 class="text-sm sm:text-base font-black text-white uppercase tracking-wider">
            EXPLAIN
          </h4>
          <span class="block text-xs text-[#94A3B8] mt-0.5">
            (Right Solution)
          </span>
        </div>

        {/* Plus Symbol */}
        <div class="text-[#7CFF3A] font-black text-2xl lg:text-3xl shrink-0 select-none">
          +
        </div>

        {/* Step 3: TRUST */}
        <div class="flex-1 text-center w-full">
          <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto rounded-2xl bg-[#151C19] border border-[#24322B] flex items-center justify-center text-white mb-3">
            <svg class="w-9 h-9 text-[#7CFF3A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h4 class="text-sm sm:text-base font-black text-white uppercase tracking-wider">
            TRUST
          </h4>
          <span class="block text-xs text-[#94A3B8] mt-0.5">
            (Our Commitment)
          </span>
        </div>

        {/* Plus Symbol */}
        <div class="text-[#7CFF3A] font-black text-2xl lg:text-3xl shrink-0 select-none">
          +
        </div>

        {/* Step 4: VALUE */}
        <div class="flex-1 text-center w-full">
          <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto rounded-2xl bg-[#151C19] border border-[#24322B] flex items-center justify-center text-[#7CFF3A] mb-3">
            <svg class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h4 class="text-sm sm:text-base font-black text-white uppercase tracking-wider">
            VALUE
          </h4>
          <span class="block text-xs text-[#94A3B8] mt-0.5">
            (Quality & Safety)
          </span>
        </div>

        {/* Plus Symbol */}
        <div class="text-[#7CFF3A] font-black text-2xl lg:text-3xl shrink-0 select-none">
          +
        </div>

        {/* Step 5: PAYMENT */}
        <div class="flex-1 text-center w-full">
          <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto rounded-2xl bg-[#151C19] border border-[#24322B] flex items-center justify-center text-white mb-3">
            <div class="flex flex-col items-center">
              <span class="text-2xl font-black text-[#7CFF3A]">₹</span>
              <svg class="w-6 h-6 -mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11" />
              </svg>
            </div>
          </div>
          <h4 class="text-sm sm:text-base font-black text-white uppercase tracking-wider">
            PAYMENT
          </h4>
          <span class="block text-xs text-[#94A3B8] mt-0.5">
            (Your Peace of Mind)
          </span>
        </div>

        {/* Equals Symbol */}
        <div class="text-[#7CFF3A] font-black text-3xl shrink-0 select-none">
          =
        </div>

        {/* Final Equal Card: LONG TERM SAFETY & HAPPINESS */}
        <div class="flex-1 text-center w-full bg-[#151C19] p-4 rounded-2xl border-2 border-[#7CFF3A] shadow-[0_0_20px_rgba(124,255,58,0.3)]">
          <div class="w-12 h-12 mx-auto rounded-xl bg-[#7CFF3A]/20 flex items-center justify-center text-[#7CFF3A] mb-2">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h4 class="text-xs sm:text-sm font-black text-white uppercase tracking-tight leading-tight">
            LONG TERM SAFETY & HAPPINESS
          </h4>
        </div>

      </div>

    </div>

    {/* Bottom Tagline matching Reference Image 5 */}
    <div class="mt-8 text-center flex items-center justify-center gap-4">
      <div class="h-0.5 w-12 sm:w-24 bg-[#7CFF3A]"></div>
      <h3 class="text-sm sm:text-lg font-black text-white uppercase tracking-widest">
        BUILDING SAFER SPACES, TOGETHER
      </h3>
      <div class="h-0.5 w-12 sm:w-24 bg-[#7CFF3A]"></div>
    </div>

  </div>

</section>
