---
---

<section class="py-12 sm:py-16 bg-[#0B0D0C] relative overflow-hidden text-white select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Main Formula Card matching reference screenshot */}
    <div class="relative bg-[#071610]/95 backdrop-blur-xl rounded-3xl border-2 border-[#028A0F] hover:border-[#7CFF3A] p-5 sm:p-8 shadow-[0_0_50px_rgba(2,138,15,0.25)] transition-all">
      
      {/* Centered Top Badge: OUR FORMULA in neon green pill */}
      <div class="absolute -top-5 left-1/2 -translate-x-1/2 z-20">
        <div class="px-7 py-2 rounded-full bg-gradient-to-r from-[#7CFF3A] via-[#5DE021] to-[#7CFF3A] text-black font-black text-xs sm:text-sm tracking-widest uppercase shadow-[0_0_30px_rgba(124,255,58,0.7)] flex items-center gap-2">
          <span>✨</span>
          <span>OUR FORMULA</span>
          <span>✨</span>
        </div>
      </div>

      {/* Responsive Horizontal Strip of Cards matching reference image */}
      <div class="pt-6 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 items-stretch text-center">
        
        {/* Step 1: PROBLEM */}
        <div class="rounded-2xl bg-[#0C1E16] border border-[#7CFF3A]/30 p-3 sm:p-4 flex flex-col justify-between hover:border-[#7CFF3A] transition shadow-lg">
          <div>
            <div className="relative w-full h-16 sm:h-20 rounded-xl overflow-hidden bg-black/60 mb-2.5 flex items-center justify-center border border-white/10">
              <img
                src="/images/before-pigeon-mess.jpg"
                alt="Pigeon Mess & Open Balcony Risk"
                class="w-full h-full object-cover filter brightness-90"
              />
              <span class="absolute top-1 right-1 bg-red-600 text-white text-[9px] font-black px-1.5 py-0.5 rounded shadow">
                ⚠️
              </span>
            </div>
            <h4 class="text-xs sm:text-sm font-black text-white uppercase tracking-wider">
              PROBLEM
            </h4>
          </div>
          <p class="text-[10px] sm:text-[11px] text-gray-300 font-semibold leading-tight mt-1.5">
            Pigeon Mess & Open Balcony Risk
          </p>
        </div>

        {/* Step 2: EXPLAIN */}
        <div class="rounded-2xl bg-[#0C1E16] border border-[#7CFF3A]/30 p-3 sm:p-4 flex flex-col justify-between hover:border-[#7CFF3A] transition shadow-lg relative">
          <span class="hidden lg:block absolute -left-3 top-1/2 -translate-y-1/2 text-[#7CFF3A] font-black text-xl z-10">+</span>
          <div>
            <div class="w-full h-16 sm:h-20 rounded-xl overflow-hidden bg-[#132A20] border border-[#7CFF3A]/40 mb-2.5 flex items-center justify-center">
              <div class="flex flex-col items-center justify-center text-[#7CFF3A]">
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                </svg>
                <span class="text-[9px] font-bold text-white mt-0.5">SS 316 CABLE</span>
              </div>
            </div>
            <h4 class="text-xs sm:text-sm font-black text-white uppercase tracking-wider">
              EXPLAIN
            </h4>
          </div>
          <p class="text-[10px] sm:text-[11px] text-[#7CFF3A] font-bold leading-tight mt-1.5">
            (Right Solution)<br />
            <span class="text-white font-normal text-[10px]">SS 316 | 1.5 / 2 / 2.5 mm | Strong & Durable</span>
          </p>
        </div>

        {/* Step 3: TRUST */}
        <div class="rounded-2xl bg-[#0C1E16] border border-[#7CFF3A]/30 p-3 sm:p-4 flex flex-col justify-between hover:border-[#7CFF3A] transition shadow-lg relative">
          <span class="hidden lg:block absolute -left-3 top-1/2 -translate-y-1/2 text-[#7CFF3A] font-black text-xl z-10">+</span>
          <div>
            <div class="w-full h-16 sm:h-20 rounded-xl overflow-hidden bg-[#132A20] border border-[#7CFF3A]/40 mb-2.5 flex items-center justify-center">
              <div class="flex flex-col items-center justify-center text-[#7CFF3A]">
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span class="text-[9px] font-extrabold text-white mt-0.5">SS 316</span>
              </div>
            </div>
            <h4 class="text-xs sm:text-sm font-black text-white uppercase tracking-wider">
              TRUST
            </h4>
          </div>
          <p class="text-[10px] sm:text-[11px] text-[#7CFF3A] font-bold leading-tight mt-1.5">
            (Our Commitment)<br />
            <span class="text-white font-normal text-[10px]">10 Yr Warranty | Certifications | Quality Material</span>
          </p>
        </div>

        {/* Step 4: VALUE */}
        <div class="rounded-2xl bg-[#0C1E16] border border-[#7CFF3A]/30 p-3 sm:p-4 flex flex-col justify-between hover:border-[#7CFF3A] transition shadow-lg relative">
          <span class="hidden lg:block absolute -left-3 top-1/2 -translate-y-1/2 text-[#7CFF3A] font-black text-xl z-10">+</span>
          <div>
            <div class="w-full h-16 sm:h-20 rounded-xl overflow-hidden bg-[#132A20] border border-[#7CFF3A]/40 mb-2.5 flex items-center justify-center">
              <div class="flex flex-col items-center justify-center text-[#7CFF3A]">
                <span class="text-xl">🏃💨 ✂️</span>
                <span class="text-[9px] font-extrabold text-emerald-300 mt-0.5">EXIT &lt; 60s</span>
              </div>
            </div>
            <h4 class="text-xs sm:text-sm font-black text-white uppercase tracking-wider">
              VALUE
            </h4>
          </div>
          <p class="text-[10px] sm:text-[11px] text-[#7CFF3A] font-bold leading-tight mt-1.5">
            (Fire Escape Safety / Wire Cutting)<br />
            <span class="text-white font-normal text-[10px]">Second Life for Your Grill</span>
          </p>
        </div>

        {/* Step 5: PAYMENT */}
        <div class="rounded-2xl bg-[#0C1E16] border border-[#7CFF3A]/30 p-3 sm:p-4 flex flex-col justify-between hover:border-[#7CFF3A] transition shadow-lg relative">
          <span class="hidden lg:block absolute -left-3 top-1/2 -translate-y-1/2 text-[#7CFF3A] font-black text-xl z-10">+</span>
          <div>
            <div class="w-full h-16 sm:h-20 rounded-xl overflow-hidden bg-[#132A20] border border-[#7CFF3A]/40 mb-2.5 flex items-center justify-center">
              <div class="w-10 h-10 rounded-full bg-[#7CFF3A]/20 border border-[#7CFF3A] flex items-center justify-center text-xl font-black text-[#7CFF3A]">
                ₹
              </div>
            </div>
            <h4 class="text-xs sm:text-sm font-black text-white uppercase tracking-wider">
              PAYMENT
            </h4>
          </div>
          <p class="text-[10px] sm:text-[11px] text-gray-300 font-semibold leading-tight mt-1.5">
            (No Hidden Charges / COD Available)
          </p>
        </div>

        {/* Final Equal Card: LONG TERM SAFETY & HAPPINESS */}
        <div class="rounded-2xl bg-gradient-to-b from-[#132A20] to-[#0A1B14] border-2 border-[#7CFF3A] p-3 sm:p-4 flex flex-col justify-between shadow-[0_0_25px_rgba(124,255,58,0.3)] relative">
          <span class="hidden lg:block absolute -left-3 top-1/2 -translate-y-1/2 text-[#7CFF3A] font-black text-2xl z-10">=</span>
          <div>
            <div class="w-full h-16 sm:h-20 rounded-xl bg-[#7CFF3A]/15 border border-[#7CFF3A]/50 mb-2.5 flex items-center justify-center text-[#7CFF3A]">
              <span class="text-3xl">😊</span>
            </div>
            <h4 class="text-xs sm:text-sm font-black text-[#7CFF3A] uppercase tracking-tight leading-tight">
              LONG TERM SAFETY & HAPPINESS
            </h4>
          </div>
          <span class="text-[9px] font-bold text-gray-300 mt-1 uppercase tracking-widest">
            10-Year Peace
          </span>
        </div>

      </div>

    </div>

    {/* Bottom Line Divider matching reference image: — BUILDING SAFER SPACES, TOGETHER — */}
    <div class="mt-8 text-center flex items-center justify-center gap-3 sm:gap-6">
      <div class="h-0.5 flex-1 max-w-[120px] sm:max-w-[200px] bg-gradient-to-r from-transparent to-[#7CFF3A]"></div>
      <h3 class="text-xs sm:text-base font-black text-white uppercase tracking-[0.25em] flex items-center gap-2">
        <span>BUILDING SAFER SPACES, TOGETHER</span>
      </h3>
      <div class="h-0.5 flex-1 max-w-[120px] sm:max-w-[200px] bg-gradient-to-l from-transparent to-[#7CFF3A]"></div>
    </div>

  </div>
</section>

