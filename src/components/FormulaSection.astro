---
---

<section class="py-20 bg-[#0B0D0C] border-t border-[#24322B] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
        <span>The D-VIEW Process</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        OUR <span class="text-[#7CFF3A]">FORMULA</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#C7CDD1]">
        A transparent, consultative engineering process designed to eliminate guesswork and deliver enduring safety.
      </p>
    </div>

    {/* The 5-Step Chain */}
    <div class="grid grid-cols-1 md:grid-cols-5 gap-4 relative">
      
      {/* 01: Problem */}
      <div class="bg-[#121816] rounded-2xl border border-[#24322B] p-6 relative flex flex-col justify-between group hover:border-[#7CFF3A]/40 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-black text-[#7CFF3A] tracking-wider uppercase">Step 01</span>
            <span class="text-xs font-extrabold text-[#64748B]">ISSUE</span>
          </div>
          <h3 class="text-lg font-black text-white mb-2">PROBLEM</h3>
          <p class="text-xs text-[#C7CDD1] leading-relaxed">
            We listen to your specific household safety concern—whether toddler fall prevention, active pet security, or aggressive pigeon intrusion.
          </p>
        </div>
        <div class="mt-6 pt-3 border-t border-[#24322B] text-[11px] text-[#94A3B8]">
          On-site space audit
        </div>
      </div>

      {/* 02: Explain */}
      <div class="bg-[#121816] rounded-2xl border border-[#24322B] p-6 relative flex flex-col justify-between group hover:border-[#7CFF3A]/40 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-black text-[#7CFF3A] tracking-wider uppercase">Step 02</span>
            <span class="text-xs font-extrabold text-[#64748B]">CLARITY</span>
          </div>
          <h3 class="text-lg font-black text-white mb-2">EXPLAIN</h3>
          <p class="text-xs text-[#C7CDD1] leading-relaxed">
            Our technical engineers recommend the precise wire diameter (2.0, 2.5, or 3.0mm) and track profile suited to your floor height and climate.
          </p>
        </div>
        <div class="mt-6 pt-3 border-t border-[#24322B] text-[11px] text-[#94A3B8]">
          Physical wire samples shown
        </div>
      </div>

      {/* 03: Trust */}
      <div class="bg-[#121816] rounded-2xl border border-[#24322B] p-6 relative flex flex-col justify-between group hover:border-[#7CFF3A]/40 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-black text-[#7CFF3A] tracking-wider uppercase">Step 03</span>
            <span class="text-xs font-extrabold text-[#64748B]">HONESTY</span>
          </div>
          <h3 class="text-lg font-black text-white mb-2">TRUST</h3>
          <p class="text-xs text-[#C7CDD1] leading-relaxed">
            Zero exaggerated marketing claims. Verified metallurgical certificates, accurate laser measurements, and clear written warranties.
          </p>
        </div>
        <div class="mt-6 pt-3 border-t border-[#24322B] text-[11px] text-[#94A3B8]">
          Documented guarantee
        </div>
      </div>

      {/* 04: Value */}
      <div class="bg-[#121816] rounded-2xl border border-[#24322B] p-6 relative flex flex-col justify-between group hover:border-[#7CFF3A]/40 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-black text-[#7CFF3A] tracking-wider uppercase">Step 04</span>
            <span class="text-xs font-extrabold text-[#64748B]">CRAFT</span>
          </div>
          <h3 class="text-lg font-black text-white mb-2">VALUE</h3>
          <p class="text-xs text-[#C7CDD1] leading-relaxed">
            High-tensile Grade 316 cables anchored with structural expansion fasteners by full-time certified technicians, completed in 4 to 6 hours.
          </p>
        </div>
        <div class="mt-6 pt-3 border-t border-[#24322B] text-[11px] text-[#94A3B8]">
          Laser tension calibrated
        </div>
      </div>

      {/* 05: Payment */}
      <div class="bg-[#121816] rounded-2xl border border-[#24322B] p-6 relative flex flex-col justify-between group hover:border-[#7CFF3A]/40 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-black text-[#7CFF3A] tracking-wider uppercase">Step 05</span>
            <span class="text-xs font-extrabold text-[#64748B]">TRANSPARENT</span>
          </div>
          <h3 class="text-lg font-black text-white mb-2">PAYMENT</h3>
          <p class="text-xs text-[#C7CDD1] leading-relaxed">
            Straightforward square-foot invoicing with zero surprise extras or hidden scaffold fees. Pay after quality inspection.
          </p>
        </div>
        <div class="mt-6 pt-3 border-t border-[#24322B] text-[11px] text-[#94A3B8]">
          Simple billing terms
        </div>
      </div>

    </div>

    {/* Final Equal Result Banner */}
    <div class="mt-8 bg-gradient-to-r from-[#151C19] via-[#1A2420] to-[#151C19] rounded-2xl border border-[#7CFF3A]/40 p-6 sm:p-8 text-center shadow-xl">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <span class="text-2xl sm:text-3xl font-black text-[#7CFF3A]">=</span>
        <h4 class="text-xl sm:text-2xl lg:text-3xl font-black text-white tracking-tight">
          LONG-TERM BALCONY SAFETY & COMPLETE PEACE OF MIND
        </h4>
      </div>
      <p class="mt-2 text-xs sm:text-sm text-[#C7CDD1] max-w-2xl mx-auto">
        No cage-like confinement. No compromised views. Just reliable, precision-engineered residential safety.
      </p>
    </div>

  </div>
</section>
