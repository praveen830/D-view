---
import type { LocationData } from '../data/locations';

interface Props {
  location?: LocationData;
}

const { location } = Astro.props;
const cityName = location ? location.name : 'Andhra Pradesh';

const services = [
  {
    title: 'PREMIUM INVISIBLE GRILLS',
    subtitle: 'High-Tensile SS-316 Stainless Steel System',
    description: 'Our flagship architectural safety solution. High-strength 316 cables spaced at 2 inches preserve 99% of your view while offering certified fall protection for children, elders, and pets.',
    points: ['SS-316 Marine Grade Cables', '6063-T6 Extruded Aluminum Track', '5-10 Year Rust Warranty', 'Zero View Obstruction'],
    link: '#calculator'
  },
  {
    title: 'BALCONY SAFETY NETS',
    subtitle: 'UV-Stabilized High-Density Polyethylene',
    description: 'Durable nylon safety netting woven with triple knots for open balconies, utility ducts, and staircase shafts. Tested for impact resistance without restricting cross-ventilation.',
    points: ['Garware / Certified HDPE Twine', 'Heat-Set Knots & UV Protected', 'Quick Installation (2-3 Hours)', 'Budget-Friendly Safety'],
    link: '#book-visit'
  },
  {
    title: 'PIGEON & BIRD NETTING',
    subtitle: 'Invisible Monofilament Bird Screens',
    description: 'Eliminate health hazards caused by pigeon droppings and nesting in balconies and AC outdoor units. Non-toxic, non-harmful, and virtually transparent from a short distance.',
    points: ['Monofilament & Wire Options', 'Zero Perching Space', 'Hygienic & Odor-Free Balconies', 'Resists Weather & Sunlight'],
    link: '#book-visit'
  },
  {
    title: 'ARCHITECTURAL TERRACE & DUCT SAFETY',
    subtitle: 'Comprehensive Multi-Story Containment',
    description: 'Custom engineered solutions for large penthouse open terraces, internal apartment atriums, and commercial common area voids across Andhra Pradesh high-rises.',
    points: ['Custom Fabricated Anchors', 'Horizontal & Vertical Layouts', 'Engineer Certified Load Tests', 'RWA Facade Compliant'],
    link: '#book-visit'
  }
];
---

<section id="services" class="py-20 bg-[#0F1412] border-t border-[#24322B] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
        <span>Complete Protection Portfolio</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        OUR CORE <span class="text-[#7CFF3A]">SAFETY SOLUTIONS</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#C7CDD1]">
        From luxury invisible wire architecture to durable bird nets, D-VIEW provides certified residential safety solutions tailored for {cityName} homes.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {services.map((service) => (
        <div class="bg-[#121816] rounded-2xl border border-[#24322B] p-7 flex flex-col justify-between hover:border-[#7CFF3A]/50 hover:bg-[#151C19] transition-all group">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#7CFF3A] block mb-1">
              {service.subtitle}
            </span>
            <h3 class="text-xl font-black text-white group-hover:text-[#7CFF3A] transition-colors mb-3">
              {service.title}
            </h3>
            <p class="text-sm text-[#C7CDD1] leading-relaxed mb-6">
              {service.description}
            </p>

            <ul class="space-y-2 mb-6">
              {service.points.map((pt) => (
                <li class="flex items-center gap-2.5 text-xs text-[#E2E8F0]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#7CFF3A]"></span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-4 border-t border-[#24322B] flex items-center justify-between">
            <a 
              href={service.link}
              class="text-xs font-bold text-[#7CFF3A] hover:underline flex items-center gap-1"
            >
              <span>Get Estimate for {service.title.split(' ')[0]}</span>
              <span>→</span>
            </a>
            <span class="text-[10px] text-[#64748B] uppercase">D-VIEW Standard</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
