---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<section class="relative min-h-[90vh] lg:min-h-screen flex items-center pt-24 pb-16 overflow-hidden">
  
  {/* Full-bleed Architectural Hero Image */}
  <div class="absolute inset-0 z-0">
    <img 
      src={location.heroImage} 
      alt={location.heroImageAlt}
      class="w-full h-full object-cover object-center filter brightness-[0.75] contrast-[1.05]"
      loading="eager"
      fetchpriority="high"
    />
    {/* Cinematic Overlays */}
    <div class="absolute inset-0 bg-gradient-to-r from-[#0B0D0C]/95 via-[#0B0D0C]/75 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0B0D0C] via-transparent to-[#0B0D0C]/40"></div>
    {/* Invisible Grill Wire Texture Effect */}
    <div class="absolute inset-0 wire-grid-overlay opacity-25 pointer-events-none"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8">
    <div class="max-w-3xl">
      
      {/* City Badge */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#121816]/90 border border-[#7CFF3A]/40 backdrop-blur-md mb-6 shadow-lg">
        <span class="w-2 h-2 rounded-full bg-[#7CFF3A] animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-[#7CFF3A]">
          {location.badge}
        </span>
      </div>

      {/* Main Headline */}
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.08] mb-6">
        {location.heroHeadline.split(' IN ')[0]} <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#7CFF3A] via-[#A6FF7A] to-white">
          IN {location.name.toUpperCase()}
        </span>
      </h1>

      {/* Subheading */}
      <p class="text-lg sm:text-xl text-[#E2E8F0] font-normal leading-relaxed mb-8 max-w-2xl text-shadow-sm">
        {location.heroSubhead}
      </p>

      {/* Primary & Secondary CTAs */}
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-12">
        <a 
          href="#book-visit" 
          class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl text-base font-extrabold text-[#0B0D0C] bg-[#7CFF3A] hover:bg-[#8FFF52] transition-all duration-200 shadow-[0_0_30px_rgba(124,255,58,0.35)] hover:shadow-[0_0_40px_rgba(124,255,58,0.5)] hover:-translate-y-0.5 active:translate-y-0 text-center"
        >
          <span>BOOK A FREE SITE VISIT</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a 
          href="#calculator" 
          class="inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-xl text-base font-bold text-white bg-[#151C19]/80 hover:bg-[#1A2420] border border-[#24322B] hover:border-[#7CFF3A]/60 backdrop-blur-md transition-all text-center"
        >
          <svg class="w-5 h-5 text-[#7CFF3A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          <span>CHECK ESTIMATED PRICE</span>
        </a>
      </div>

      {/* Engineering Trust Pillars */}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-[#24322B]/80 backdrop-blur-sm">
        <div class="bg-[#0B0D0C]/60 rounded-xl p-3 border border-[#24322B]/80">
          <span class="block text-[11px] uppercase tracking-wider text-[#94A3B8] font-medium">Metallurgy</span>
          <span class="text-sm font-extrabold text-white">SS-316 Marine</span>
        </div>
        <div class="bg-[#0B0D0C]/60 rounded-xl p-3 border border-[#24322B]/80">
          <span class="block text-[11px] uppercase tracking-wider text-[#94A3B8] font-medium">Tensile Load</span>
          <span class="text-sm font-extrabold text-[#7CFF3A]">&gt; 400 kg / wire</span>
        </div>
        <div class="bg-[#0B0D0C]/60 rounded-xl p-3 border border-[#24322B]/80">
          <span class="block text-[11px] uppercase tracking-wider text-[#94A3B8] font-medium">Transparency</span>
          <span class="text-sm font-extrabold text-white">99% Unblocked</span>
        </div>
        <div class="bg-[#0B0D0C]/60 rounded-xl p-3 border border-[#24322B]/80">
          <span class="block text-[11px] uppercase tracking-wider text-[#94A3B8] font-medium">Warranty</span>
          <span class="text-sm font-extrabold text-[#7CFF3A]">5-10 Year Rust</span>
        </div>
      </div>

    </div>
  </div>

</section>
