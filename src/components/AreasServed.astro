---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<section id="areas-served" class="py-20 bg-slate-50 border-t border-slate-200 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-semibold text-[#16A34A] uppercase tracking-wider mb-4">
        <span>Local Residential Coverage & Active Services</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        {location.areasHeadline}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        {location.areasSubtitle} Our dedicated field teams provide direct laser site measurements and same-week installations across all residential zones.
      </p>
    </div>

    {/* Areas Grid with Services Provided */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {location.areas.map((area) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-5 hover:border-emerald-500 hover:shadow-xl transition-all duration-300 group flex flex-col justify-between shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-base font-extrabold text-slate-900 group-hover:text-[#16A34A] transition-colors">
                {area.name}
              </h3>
              <span class="w-2.5 h-2.5 rounded-full bg-[#16A34A] shadow-sm"></span>
            </div>
            
            <span class="block text-xs font-semibold text-slate-500 mb-2">
              {area.type}
            </span>
            
            <p class="text-[11px] text-slate-600 mb-4 leading-relaxed">
              {area.highlight}
            </p>

            {/* Services provided in this specific locality */}
            <div class="pt-3 border-t border-slate-100 space-y-1.5">
              <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">
                Services Provided in {area.name}:
              </span>
              <div class="flex flex-wrap gap-1">
                <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 font-semibold border border-emerald-200">
                  SS-316 Invisible Grills
                </span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
                  Pigeon Defense
                </span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
                  Child Safety
                </span>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100">
            <a
              href="#book-visit"
              class="w-full py-1.5 text-center text-xs font-bold text-[#16A34A] group-hover:text-emerald-700 flex items-center justify-between transition-colors"
            >
              <span>Book in {area.name}</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    {/* Callout box */}
    <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-white border border-emerald-200 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-md">
      <div class="text-center sm:text-left">
        <span class="text-base font-extrabold text-slate-900 block mb-1">
          Don't see your specific apartment or gated community listed?
        </span>
        <span class="text-xs text-slate-600">
          Our technical mobile teams cover all residential sectors across greater {location.name} and {location.district} district with free on-site laser surveys.
        </span>
      </div>
      <a
        href="#book-visit"
        class="shrink-0 px-6 py-3 rounded-xl text-xs font-black text-slate-950 bg-[#7CFF3A] hover:bg-[#6be630] transition-colors shadow-md"
      >
        Request Free Measurement in Your Area →
      </a>
    </div>

  </div>
</section>
