---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<section id="areas-served" class="py-20 bg-[#0F1412] border-t border-[#24322B] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
        <span>Local Residential Coverage & Active Services</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {location.areasHeadline}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#C7CDD1]">
        {location.areasSubtitle} Our dedicated field teams provide direct laser site measurements and same-week installations across all residential zones.
      </p>
    </div>

    {/* Areas Grid with Services Provided */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {location.areas.map((area) => (
        <div class="bg-[#121816] rounded-2xl border border-[#24322B] p-5 hover:border-[#7CFF3A]/60 hover:bg-[#151C19] transition-all duration-300 group flex flex-col justify-between shadow-lg">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-base font-extrabold text-white group-hover:text-[#7CFF3A] transition-colors">
                {area.name}
              </h3>
              <span class="w-2 h-2 rounded-full bg-[#7CFF3A] shadow-[0_0_8px_rgba(124,255,58,0.8)]"></span>
            </div>
            
            <span class="block text-xs font-semibold text-[#94A3B8] mb-2">
              {area.type}
            </span>
            
            <p class="text-[11px] text-[#C7CDD1] mb-4">
              {area.highlight}
            </p>

            {/* Services provided in this specific locality */}
            <div class="pt-3 border-t border-[#24322B]/70 space-y-1.5">
              <span class="text-[10px] font-bold text-[#94A3B8] uppercase tracking-wider block">
                Services Provided in {area.name}:
              </span>
              <div class="flex flex-wrap gap-1">
                <span class="text-[10px] px-2 py-0.5 rounded bg-[#1A2420] text-[#7CFF3A] font-semibold border border-[#24322B]">
                  SS-316 Invisible Grills
                </span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-[#1A2420] text-[#E2E8F0] border border-[#24322B]">
                  Pigeon Defense
                </span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-[#1A2420] text-[#E2E8F0] border border-[#24322B]">
                  Child Safety
                </span>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-[#24322B]">
            <a
              href="#book-visit"
              class="w-full py-1.5 text-center text-xs font-bold text-[#7CFF3A] group-hover:text-white flex items-center justify-between transition-colors"
            >
              <span>Book in {area.name}</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    {/* Callout box */}
    <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-[#151C19] border border-[#24322B] flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl">
      <div class="text-center sm:text-left">
        <span class="text-base font-extrabold text-white block mb-1">
          Don't see your specific apartment or gated community listed?
        </span>
        <span class="text-xs text-[#94A3B8]">
          Our technical mobile teams cover all residential sectors across greater {location.name} and {location.district} district with free on-site laser surveys.
        </span>
      </div>
      <a
        href="#book-visit"
        class="shrink-0 px-6 py-3 rounded-xl text-xs font-black text-[#0B0D0C] bg-[#7CFF3A] hover:bg-[#8FFF52] transition-colors shadow-lg"
      >
        Request Free Measurement in Your Area →
      </a>
    </div>

  </div>
</section>
