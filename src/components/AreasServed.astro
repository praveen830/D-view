---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<section class="py-20 bg-[#0F1412] border-t border-[#24322B] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
        <span>Local Residential Coverage</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {location.areasHeadline}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#C7CDD1]">
        {location.areasSubtitle}
      </p>
    </div>

    {/* Areas Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {location.areas.map((area) => (
        <div class="bg-[#121816] rounded-xl border border-[#24322B] p-5 hover:border-[#7CFF3A]/50 hover:bg-[#151C19] transition-all duration-200 group">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-base font-bold text-white group-hover:text-[#7CFF3A] transition-colors">
              {area.name}
            </h3>
            <span class="w-1.5 h-1.5 rounded-full bg-[#7CFF3A]"></span>
          </div>
          <span class="block text-xs font-medium text-[#94A3B8] mb-2">
            {area.type}
          </span>
          <p class="text-[11px] text-[#C7CDD1] border-t border-[#24322B]/60 pt-2">
            {area.highlight}
          </p>
        </div>
      ))}
    </div>

    {/* Callout box */}
    <div class="mt-10 p-6 rounded-2xl bg-[#151C19] border border-[#24322B] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <span class="text-sm font-bold text-white block">
          Don't see your specific apartment colony listed?
        </span>
        <span class="text-xs text-[#94A3B8]">
          Our technical mobile teams cover all residential sectors across greater {location.name} and {location.district} district.
        </span>
      </div>
      <a
        href="#book-visit"
        class="shrink-0 px-5 py-2.5 rounded-xl text-xs font-bold text-[#0B0D0C] bg-[#7CFF3A] hover:bg-[#8FFF52] transition-colors"
      >
        Request Free Measurement in Your Area →
      </a>
    </div>

  </div>
</section>
