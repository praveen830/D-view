---
import type { LocationData } from '../data/locations';

interface Props {
  location?: LocationData;
}

const { location } = Astro.props;
const cityName = location ? location.name : 'Andhra Pradesh';

const pillars = [
  {
    title: 'Certified SS-316 Metallurgy',
    desc: 'We never compromise with lower grades like SS-202 or SS-304. Every batch of our marine-grade cable carries documented alloy test verification.',
    tag: 'Grade 316 Verified'
  },
  {
    title: 'Accurate Laser Measurement',
    desc: 'Our engineers utilize Leica digital laser meters to gauge structural square-footage with sub-millimeter precision, guaranteeing exact tension alignment.',
    tag: 'Digital Accuracy'
  },
  {
    title: 'Permanent In-House Crews',
    desc: 'We do not subcontract work to untrained freelance labor. All D-VIEW installers are factory-trained on high-rise safety protocols and anchor depth standards.',
    tag: 'Certified Technicians'
  },
  {
    title: 'Transparent Written Invoices',
    desc: 'Honest, itemized square-foot pricing with zero unexpected fees for anchors, drill bits, high-floor balcony ladders, or basic site adjustments.',
    tag: 'Zero Hidden Costs'
  },
  {
    title: '5 to 10 Year Written Guarantee',
    desc: 'Backed by our written company warranty against structural wire deterioration and premature component corrosion under normal residential care.',
    tag: 'Documented Warranty'
  },
  {
    title: `Local ${cityName} Quick Response`,
    desc: 'Direct field teams based right within your district ensure rapid measurement appointments within 24 hours and ongoing maintenance support.',
    tag: 'Direct Regional Team'
  }
];
---

<section class="py-20 bg-[#0F1412] border-t border-[#24322B] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
        <span>The D-VIEW Standard</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        WHY PROPERTY OWNERS IN <br />
        <span class="text-[#7CFF3A]">{cityName.toUpperCase()} TRUST D-VIEW</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#C7CDD1]">
        Balcony safety is a life-critical installation. Here is why discerning architects, high-rise builders, and families choose our engineering approach.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pillars.map((p, index) => (
        <div class="bg-[#121816] rounded-2xl border border-[#24322B] p-6 hover:border-[#7CFF3A]/40 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-extrabold text-[#7CFF3A] bg-[#1A2420] px-2.5 py-1 rounded-md border border-[#24322B]">
                0{index + 1}
              </span>
              <span class="text-[11px] font-semibold text-[#94A3B8]">
                {p.tag}
              </span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">
              {p.title}
            </h3>
            <p class="text-xs text-[#C7CDD1] leading-relaxed">
              {p.desc}
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-[#24322B]/60 text-[11px] text-[#64748B]">
            D-VIEW Quality Assured
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
