---
import type { LocationData } from '../data/locations';

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<section class="py-20 bg-[#0F1412] border-t border-[#24322B] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Trust Badges Grid */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mb-16">
      
      <div class="bg-[#121816] p-5 sm:p-6 rounded-2xl border border-[#24322B] text-center flex flex-col items-center justify-center">
        <div class="w-12 h-12 rounded-xl bg-[#1A2420] border border-[#7CFF3A]/30 flex items-center justify-center text-[#7CFF3A] mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <span class="text-xl sm:text-2xl font-black text-white block">5 to 10 Years</span>
        <span class="text-xs text-[#94A3B8] font-medium mt-1">Written Material Warranty</span>
      </div>

      <div class="bg-[#121816] p-5 sm:p-6 rounded-2xl border border-[#24322B] text-center flex flex-col items-center justify-center">
        <div class="w-12 h-12 rounded-xl bg-[#1A2420] border border-[#7CFF3A]/30 flex items-center justify-center text-[#7CFF3A] mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <span class="text-xl sm:text-2xl font-black text-white block">4 to 6 Hours</span>
        <span class="text-xs text-[#94A3B8] font-medium mt-1">Clean, Zero-Mess Installation</span>
      </div>

      <div class="bg-[#121816] p-5 sm:p-6 rounded-2xl border border-[#24322B] text-center flex flex-col items-center justify-center">
        <div class="w-12 h-12 rounded-xl bg-[#1A2420] border border-[#7CFF3A]/30 flex items-center justify-center text-[#7CFF3A] mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
        </div>
        <span class="text-xl sm:text-2xl font-black text-white block">100% SS-316</span>
        <span class="text-xs text-[#94A3B8] font-medium mt-1">Verified Metallurgical Grade</span>
      </div>

      <div class="bg-[#121816] p-5 sm:p-6 rounded-2xl border border-[#24322B] text-center flex flex-col items-center justify-center">
        <div class="w-12 h-12 rounded-xl bg-[#1A2420] border border-[#7CFF3A]/30 flex items-center justify-center text-[#7CFF3A] mb-3">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
        </div>
        <span class="text-xl sm:text-2xl font-black text-white block">Local {location.name}</span>
        <span class="text-xs text-[#94A3B8] font-medium mt-1">Direct Field Technical Team</span>
      </div>

    </div>

    {/* Section 20: Complimentary Maintenance Kit Promo Card */}
    <div class="bg-gradient-to-br from-[#151C19] via-[#121816] to-[#0A0D0C] rounded-3xl border border-[#24322B] overflow-hidden shadow-2xl relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
        
        {/* Left: Product Kit Image */}
        <div class="lg:col-span-5 relative h-72 sm:h-80 lg:h-full min-h-[300px] overflow-hidden">
          <img 
            src="/images/maintenance-kit.jpg" 
            alt="D-VIEW Balcony Maintenance Kit with shine spray and microfiber cloth" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-transparent via-transparent to-[#151C19]"></div>
        </div>

        {/* Right: Copy & Value Offer */}
        <div class="lg:col-span-7 p-6 sm:p-10 lg:p-12 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1A2420] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider">
            <span>Official Customer Care Initiative</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            COMPLIMENTARY BALCONY <br />
            <span class="text-[#7CFF3A]">CARE & MAINTENANCE KIT</span>
          </h3>

          <p class="text-sm text-[#C7CDD1] leading-relaxed">
            Selected customers who schedule their balcony safety installation through our website receive a complimentary <strong class="text-white">D-VIEW Balcony Maintenance Kit</strong>.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <div class="flex items-center gap-2.5 bg-[#121816] p-3 rounded-xl border border-[#24322B]">
              <span class="w-2 h-2 rounded-full bg-[#7CFF3A]"></span>
              <span class="text-xs text-white font-medium">500ml D-VIEW Shine & Coat Spray</span>
            </div>
            <div class="flex items-center gap-2.5 bg-[#121816] p-3 rounded-xl border border-[#24322B]">
              <span class="w-2 h-2 rounded-full bg-[#7CFF3A]"></span>
              <span class="text-xs text-white font-medium">Ultra-Soft Microfiber Detailing Cloth</span>
            </div>
          </div>

          <p class="text-[11px] text-[#64748B] pt-1">
            * Provided with full balcony installations to help maintain optical wire transparency and coating luster across {location.name}'s seasons.
          </p>

          <div class="pt-2">
            <a 
              href="#book-visit" 
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-xs font-bold text-[#0B0D0C] bg-[#7CFF3A] hover:bg-[#8FFF52] transition-colors"
            >
              <span>Claim With Free Site Measurement</span>
              <span>→</span>
            </a>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
