---
import Layout from '../../layouts/Layout.astro';
import DViewWebsite from '../../components/DViewWebsite.tsx';
import { ALL_LOCATIONS, type LocationData } from '../../data/locations';

export async function getStaticPaths() {
  const cityAliases: Record<string, string> = {
    'vizag': 'visakhapatnam',
    'visakhapatnam': 'visakhapatnam',
    'rajahmundry': 'rajahmundry',
    'rajamahendravaram': 'rajahmundry',
    'vijayawada': 'vijayawada-amaravati',
    'amaravati': 'vijayawada-amaravati',
    'vijayawada-amaravati': 'vijayawada-amaravati',
    'guntur': 'guntur',
    'kakinada': 'kakinada',
    'nellore': 'nellore'
  };

  return Object.entries(cityAliases).map(([alias, targetSlug]) => {
    const loc = ALL_LOCATIONS.find(l => l.slug === targetSlug) || ALL_LOCATIONS[0];
    return {
      params: { city: alias },
      props: { location: loc, slug: alias }
    };
  });
}

interface Props {
  location: LocationData;
  slug: string;
}

const { location, slug } = Astro.props;
const corridorParam = Astro.url.searchParams.get('corridor') || undefined;
---

<Layout
  title={`${location.name} The 6-Pillar Problem Solver | D-VIEW Luxury Architectural Safety`}
  description={`Discover the 6 architectural proof solutions of D-VIEW SS-316 invisible safety grills in ${location.name}. Child safety, pet protection, pigeon defense, 1-minute fire egress, and transparent luxury airflow.`}
  canonicalUrl={`https://dviewsolutions.in/safety-pillars/${slug}`}
  cityName={location.name}
  ogImage={location.heroImage}
  keywords={location.keywords}
>
  <DViewWebsite client:load initialCitySlug={slug} initialCorridor={corridorParam} tier="tier3" />
</Layout>
