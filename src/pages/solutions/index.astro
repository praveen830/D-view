---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import PriceCalculator from '../../components/PriceCalculator';
import PhotoGallery from '../../components/PhotoGallery.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import SiteVisitForm from '../../components/SiteVisitForm';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Luxury Invisible Grills & Balcony Safety Solutions | D-VIEW Solutions"
  description="Explore D-VIEW's certified SS-316 invisible grills: balcony safety grills, window grills, pigeon barrier grills, and high-rise containment across Andhra Pradesh."
  canonicalUrl="https://dviewsolutions.in/solutions"
>
  <Navbar client:load />

  <main class="pt-28 pb-16 bg-[#0a0f0d]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#131b17] border border-[#22c55e]/30 text-xs font-bold text-[#22c55e] uppercase tracking-wider mb-4">
          <span>Engineered Invisible Grill Collections</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
          ARCHITECTURAL INVISIBLE GRILLS <br />
          <span class="text-[#22c55e]">WITHOUT COMPROMISE</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-[#cbd5e1]">
          Architectural grade fall prevention, pet security, and bird defense engineered strictly with certified SS-316 marine stainless steel across Andhra Pradesh.
        </p>
      </div>

    </div>

    <ServicesGrid />
    <PhotoGallery cityName="Andhra Pradesh" />
    <PriceCalculator client:load defaultCitySlug="visakhapatnam" cityName="Andhra Pradesh" />
    <SiteVisitForm client:visible defaultCitySlug="visakhapatnam" cityName="Andhra Pradesh" />
  </main>

  <Footer />
</Layout>
