---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import PriceCalculator from '../../components/PriceCalculator';
import MaterialSection from '../../components/MaterialSection.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import SiteVisitForm from '../../components/SiteVisitForm';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Balcony Safety Solutions | Invisible Grills & Nets | D-VIEW Solutions"
  description="Explore D-VIEW's certified safety systems: SS-316 invisible grills, balcony safety nets, pigeon protection, and high-rise containment in Andhra Pradesh."
  canonicalUrl="https://dviewsolutions.in/solutions"
>
  <Navbar client:load />

  <main class="pt-28 pb-16 bg-[#0B0D0C]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
          <span>Engineered Residential Solutions</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
          BALCONY SAFETY <br />
          <span class="text-[#7CFF3A]">WITHOUT COMPROMISE</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-[#C7CDD1]">
          Architectural grade fall prevention, pet security, and bird exclusion engineered specifically for high-rise residential towers across Andhra Pradesh.
        </p>
      </div>

    </div>

    <ServicesGrid />
    <MaterialSection />
    <PriceCalculator client:load defaultCitySlug="rajahmundry" cityName="Andhra Pradesh" />
    <SiteVisitForm client:visible defaultCitySlug="rajahmundry" cityName="Andhra Pradesh" />
  </main>

  <Footer />
</Layout>
