---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider';
import HorizontalProblemSlider from '../components/HorizontalProblemSlider';
import HeroPriceCalculator from '../components/HeroPriceCalculator';
import { ALL_LOCATIONS, type LocationData } from '../data/locations';

export async function getStaticPaths() {
  const cityAliases: Record<string, string> = {
    'vizag': 'visakhapatnam',
    'visakhapatnam': 'visakhapatnam',
    'rajahmundry': 'rajahmundry',
    'rajamahendravaram': 'rajahmundry',
    'vijayawada': 'vijayawada-amaravati',
    'amaravati': 'vijayawada-amaravati',
    'vijayawada-amaravati': 'vijayawada-amaravati',
    'guntur': 'guntur',
    'kakinada': 'kakinada',
    'nellore': 'nellore',
    'ongole': 'ongole'
  };

  return Object.entries(cityAliases).map(([citySlug, targetSlug]) => {
    const locData = ALL_LOCATIONS.find(l => l.slug === targetSlug) || ALL_LOCATIONS[0];
    return {
      params: { city: citySlug },
      props: { location: locData, slug: citySlug }
    };
  });
}

interface Props {
  location: LocationData;
  slug: string;
}

const { location, slug } = Astro.props;

const cityName = location.cityName || location.name;
const heroImage = location.heroImage;
const heroPoster = location.heroPosterImage || location.heroImage;
const subLocalities = location.subLocalities || [];
---

<Layout
  title={`D-VIEW Invisible Safety | ${cityName} SS-316 Balcony Grills`}
  description={`Engineered SS-316 invisible safety grills across ${cityName}. Living spaces without fear & without cages. 100% fall protection, child & pet safety with 10-year warranty.`}
  canonicalUrl={`https://dviewsolutions.com/${slug}`}
  cityName={cityName}
  ogImage={heroImage}
  preloadHeroImage={heroImage}
  keywords={location.keywords}
  faqs={location.faqs || []}
>
  <main class="min-h-screen bg-[#0B0D0C] text-white">
    {/* TOP BRAND NAVIGATION BAR MATCHING REFERENCE SCREENSHOT */}
    <header class="w-full bg-black/60 backdrop-blur-md border-b border-white/10 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        {/* Left: Brand Logo in a clean straight line */}
        <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
          <img 
            src="/images/d-view-logo-horizontal.png" 
            alt="D-VIEW Invisible Grills & Safety Solutions" 
            class="h-8 sm:h-9 md:h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-105" 
          />
        </a>

        {/* Middle: Navigation Links */}
        <nav class="hidden md:flex items-center gap-7 text-xs font-bold tracking-wider uppercase">
          <a href="/" class="text-[#7CFF3A] hover:text-white transition flex items-center gap-1">
            Home
          </a>
          <a href="#corridors" class="text-gray-300 hover:text-[#7CFF3A] transition">
            Applications
          </a>
          <a href="#formula" class="text-gray-300 hover:text-[#7CFF3A] transition">
            About
          </a>
          <a href="/contact" class="text-gray-300 hover:text-[#7CFF3A] transition">
            Contact
          </a>
        </nav>

        {/* Right: City Service Area Pill Badge matching screenshot */}
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#121A16] border border-[#7CFF3A]/40 text-right">
          <span class="w-2.5 h-2.5 rounded-full bg-[#7CFF3A] animate-pulse"></span>
          <div>
            <span class="block text-xs font-black text-white">{cityName}</span>
            <span class="block text-[9px] font-semibold text-[#7CFF3A] uppercase tracking-wider">Our Service Area</span>
          </div>
          <span class="text-base text-gray-400 ml-1">🌉</span>
        </div>

      </div>
    </header>

    {/* TIER 1: CLEAN CITY SHOWCASE & ESTIMATE CALCULATOR (MOBILE & DESKTOP OPTIMIZED) */}
    <section class="relative w-full bg-[#080B09] py-4 sm:py-8 lg:py-12 border-b border-white/10 overflow-hidden">
      <!-- Subtle ambient background glow -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-[#7CFF3A]/5 blur-[120px] pointer-events-none rounded-full"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 w-full">

        {/* 2-COLUMN SPLIT: 4:5 POSTER IMAGE (WITH BOTTOM ACTION BUTTONS & TEXT BELOW IT) BESIDE ESTIMATE CALCULATOR */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start max-w-6xl mx-auto">
          
          {/* 4:5 CITY POSTER IMAGE + HEADING TEXT DIRECTLY BELOW IT */}
          <div class="lg:col-span-7 w-full flex flex-col items-center lg:items-start">
            
            {/* 4:5 POSTER IMAGE CARD WITH BOTTOM BORDER OVERLAY BUTTONS */}
            <div class="relative w-full rounded-3xl overflow-hidden border-2 border-[#7CFF3A]/80 bg-black shadow-[0_0_35px_rgba(124,255,58,0.25)] group">
              <img
                src={heroPoster}
                alt={`D-VIEW Invisible Safety in ${cityName}`}
                class="w-full h-auto aspect-[4/5] object-cover rounded-3xl transition-transform duration-500 group-hover:scale-[1.01]"
                loading="eager"
                decoding="async"
              />

              {/* ACTION BUTTONS ON BOTTOM BORDER OF IMAGE */}
              <div class="absolute bottom-0 inset-x-0 p-2.5 sm:p-4 bg-gradient-to-t from-black/95 via-black/80 to-transparent flex items-center justify-between gap-1.5 sm:gap-2.5 z-10 backdrop-blur-[2px]">
                {/* 1. Contact Us */}
                <a
                  href={`/contact?city=${slug}`}
                  class="flex-1 min-w-0 inline-flex items-center justify-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-2 sm:py-2.5 rounded-xl bg-black/85 hover:bg-[#151D18] text-white hover:text-[#7CFF3A] border border-white/20 hover:border-[#7CFF3A] text-[11px] sm:text-xs font-bold transition-all shadow-md text-center"
                >
                  <svg class="w-3.5 h-3.5 text-[#7CFF3A] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span class="truncate">Contact Us</span>
                </a>

                {/* 2. Free Visit (Navigates to booking site & form) */}
                <a
                  href={`/contact?city=${slug}#book-visit`}
                  class="flex-1 min-w-0 inline-flex items-center justify-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-2 sm:py-2.5 rounded-xl bg-black/85 hover:bg-[#151D18] text-white hover:text-[#7CFF3A] border border-white/20 hover:border-[#7CFF3A] text-[11px] sm:text-xs font-bold transition-all shadow-md text-center"
                >
                  <svg class="w-3.5 h-3.5 text-[#7CFF3A] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                  </svg>
                  <span class="truncate">Free Visit</span>
                </a>

                {/* 3. WhatsApp */}
                <a
                  href={`https://wa.me/919494328999?text=${encodeURIComponent('Hi, I am interested in this work. Please share the details.')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 min-w-0 inline-flex items-center justify-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-2 sm:py-2.5 rounded-xl bg-black/85 hover:bg-[#151D18] text-white hover:text-[#25D366] border border-white/20 hover:border-[#25D366] text-[11px] sm:text-xs font-bold transition-all shadow-md text-center"
                >
                  <svg class="w-3.5 h-3.5 text-[#25D366] fill-current flex-shrink-0" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                  <span class="truncate">WhatsApp</span>
                </a>
              </div>
            </div>

            {/* TEXT BELOW THE IMAGE */}
            <div class="mt-5 sm:mt-6 text-center lg:text-left w-full">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7CFF3A]/10 border border-[#7CFF3A]/30 text-[#7CFF3A] text-xs font-bold uppercase tracking-widest mb-2.5 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-[#7CFF3A] animate-pulse"></span>
                <span>Certified SS-316 Balcony Engineering</span>
              </div>
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight uppercase leading-tight">
                Invisible Safety Grills in <span class="text-[#7CFF3A]">{cityName}</span>
              </h1>
              <p class="mt-2 text-xs sm:text-sm text-gray-300 max-w-xl mx-auto lg:mx-0 leading-relaxed">
                Engineered SS-316 high-tensile balcony protection with 100% unblocked views, toddler safety, and 10-year anti-rust warranty across {cityName}.
              </p>
            </div>

          </div>

          {/* ESTIMATE CALCULATOR BESIDE IT (PAKANA ESTIMATE CALCULATOR) */}
          <div class="lg:col-span-5 w-full max-w-lg mx-auto lg:max-w-none">
            <HeroPriceCalculator client:idle citySlug={slug} cityName={cityName} />
          </div>

        </div>
      </div>
    </section>

    {/* TIER 2: HORIZONTAL SLIDING VIEW (LEFT TO RIGHT SCROLLING CARDS) */}
    <div id="problem-solutions">
      <HorizontalProblemSlider client:visible cityName={cityName} />
    </div>

    {/* INTERACTIVE 9:16 LIVE DRAG SLIDER */}
    <section class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-white/10">
      <div class="text-center max-w-2xl mx-auto mb-4">
        <span class="inline-block px-3.5 py-1 rounded-full bg-[#7CFF3A]/10 border border-[#7CFF3A]/30 text-[#7CFF3A] text-xs font-bold tracking-widest uppercase mb-1.5">
          Live Interactive Handle
        </span>
        <h3 class="text-xl sm:text-3xl font-extrabold text-white tracking-tight">
          Drag to Compare: <span class="text-[#7CFF3A]">Danger vs 100% Security</span>
        </h3>
      </div>
      <BeforeAfterSlider client:visible />
    </section>

    {/* TIER 3: REGIONAL SUB-LOCALITIES / SUB-PAGES GRID */}
    <section id="corridors" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-white/10">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block px-3.5 py-1 rounded-full bg-[#7CFF3A]/10 border border-[#7CFF3A]/30 text-[#7CFF3A] text-xs font-bold tracking-widest uppercase mb-3">
          Verified Regional Corridors
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          Active Residential Belts in <span class="text-[#7CFF3A]">{cityName}</span>
        </h2>
        <p class="mt-3 text-sm sm:text-base text-gray-400">
          Tailored on-site measurements and certified architectural installations across all premier high-rise and villa communities.
        </p>
      </div>

      <!-- Grid of Sub-Localities -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {subLocalities.map((sub, idx) => (
          <a
            href={sub.path || `/safety-pillars/${slug}?corridor=${encodeURIComponent(sub.name)}`}
            class="group rounded-2xl bg-[#0e1613] border border-white/10 hover:border-[#7CFF3A]/80 overflow-hidden transition-all duration-300 hover:shadow-[0_12px_40px_rgba(124,255,58,0.2)] flex flex-col justify-between hover:-translate-y-1.5 block cursor-pointer"
          >
            <!-- Card Image with Gradient Overlay & Badges -->
            <div class="relative w-full h-48 sm:h-52 overflow-hidden bg-black/60">
              {sub.image ? (
                <img
                  src={sub.image}
                  alt={`${sub.name} - Invisible Safety Grill Installation in ${cityName}`}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="w-full h-full bg-[#121816] flex items-center justify-center text-gray-500 text-xs">
                  {sub.name}
                </div>
              )}
              <!-- Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-[#0e1613] via-transparent to-black/40 pointer-events-none" />

              {sub.tag && (
                <div class="absolute bottom-2 left-3 right-3 pointer-events-none">
                  <span class="inline-block text-[9.5px] font-bold text-[#7CFF3A] bg-black/85 backdrop-blur-md px-2 py-0.5 rounded border border-[#7CFF3A]/30 truncate max-w-full">
                    {sub.tag}
                  </span>
                </div>
              )}
            </div>

            <!-- Card Content -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-[#7CFF3A] transition-colors leading-snug">
                  {sub.name}
                </h3>
                <p class="mt-2 text-xs sm:text-sm text-gray-400 leading-relaxed line-clamp-2">
                  {sub.desc}
                </p>

                <div class="mt-4 flex flex-wrap gap-1.5 text-[10px] font-semibold text-gray-400">
                  <span class="px-2 py-0.5 rounded bg-black/50 border border-white/10 text-gray-300">SS-316 Marine</span>
                  <span class="px-2 py-0.5 rounded bg-black/50 border border-white/10 text-gray-300">2" Safe Spacing</span>
                  <span class="px-2 py-0.5 rounded bg-[#7CFF3A]/10 border border-[#7CFF3A]/30 text-[#7CFF3A]">Verified Site</span>
                </div>
              </div>

              <div class="mt-5 pt-3 border-t border-white/5 flex items-center justify-between text-xs font-bold text-[#7CFF3A] group-hover:text-white transition-colors">
                <span>View Verified Installations</span>
                <span class="w-6 h-6 rounded-full bg-[#7CFF3A]/15 group-hover:bg-[#7CFF3A] group-hover:text-black flex items-center justify-center transition-all group-hover:translate-x-1">
                  →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* WEATHER SHIELD SECTION FOR CITY (ZERO GIFT KIT) */}
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-white/10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs uppercase tracking-[0.3em] text-[#7CFF3A] font-bold block">
            SS-316 METALLURGY TRUST & GUARANTEES
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold uppercase text-white tracking-tight">
            Specific Weather Shield ({cityName})
          </h2>
          <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
            Why cheap steel fails in Andhra Pradesh: coastal salt-air and river mists cause immediate pitting and corrosion on ordinary mild steel and cheap SS-202 cables within months.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-[#101714] border border-white/10">
              <span class="text-2xl mt-0.5">💧</span>
              <div>
                <h4 class="text-sm font-bold text-white uppercase">The Environmental Challenge</h4>
                <p class="text-xs text-gray-300 mt-1">{location.weatherChallenge}</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-[#101714] border border-[#7CFF3A]/40">
              <span class="text-2xl mt-0.5">🛡️</span>
              <div>
                <h4 class="text-sm font-bold text-[#7CFF3A] uppercase">The Material: Molybdenum-Infused SS-316</h4>
                <p class="text-xs text-gray-300 mt-1">{location.engineeringSolution}</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div class="p-4 rounded-2xl bg-[#7CFF3A]/10 border border-[#7CFF3A]/30 text-center">
              <span class="text-xl sm:text-2xl font-black text-[#7CFF3A] block">10 YEARS</span>
              <span class="text-[10px] uppercase tracking-wider text-gray-300 font-semibold block mt-0.5">
                Anti-Rust Replacement Warranty
              </span>
            </div>

            <div class="p-4 rounded-2xl bg-[#101714] border border-white/10 text-center">
              <span class="text-xl sm:text-2xl font-black text-white block">1 YEAR FREE</span>
              <span class="text-[10px] uppercase tracking-wider text-gray-300 font-semibold block mt-0.5">
                Periodic Tension Inspection
              </span>
            </div>

            <div class="p-4 rounded-2xl bg-[#7CFF3A]/10 border border-[#7CFF3A]/30 text-center">
              <span class="text-xl sm:text-2xl font-black text-[#7CFF3A] block">400+ KG</span>
              <span class="text-[10px] uppercase tracking-wider text-gray-300 font-semibold block mt-0.5">
                Cable Breaking Tension Load
              </span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-[#7CFF3A]/30 shadow-2xl group">
            <img 
              src={heroImage} 
              alt={`D-VIEW SS-316 Weather Shield in ${cityName}`} 
              class="w-full h-80 object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0f0d] via-[#0a0f0d]/60 to-transparent pointer-events-none" />
            <div class="absolute top-4 right-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-[#7CFF3A]/50 text-[10px] font-bold text-[#7CFF3A] uppercase tracking-wider shadow-lg">
                <span class="w-2 h-2 rounded-full bg-[#7CFF3A] animate-pulse" />
                ASTM B117 Saline Certified
              </span>
            </div>
            <div class="absolute bottom-6 left-6 right-6">
              <div class="inline-flex items-center gap-2 bg-[#7CFF3A] text-black text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full mb-2">
                Marine Metallurgy Armor
              </div>
              <h4 class="text-lg font-bold text-white">SS-316 Molybdenum Barrier</h4>
              <p class="text-xs text-gray-300 mt-1 leading-relaxed">
                Infused with 2.5% Molybdenum core alloy, preventing salt-spray pitting, river-fog oxidation, and thermal slackening across {cityName}.
              </p>
              <div class="mt-3 flex items-center gap-2 pt-2 border-t border-white/10 text-[10px] text-gray-300 font-mono">
                <span class="text-[#7CFF3A]">● AISI-316</span>
                <span>•</span>
                <span>400KG Tensile</span>
                <span>•</span>
                <span>UV-Nylon Core</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* CITY BOTTOM INQUIRY BANNER */}
    <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-[#121A15] to-[#18261F] border border-[#7CFF3A]/30 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold text-[#7CFF3A] uppercase tracking-wider">
            Fast Response in {cityName}
          </span>
          <h3 class="text-xl sm:text-2xl font-bold text-white mt-1">
            Need an accurate measurement for your balcony?
          </h3>
          <p class="text-xs sm:text-sm text-gray-300 mt-1">
            Our local {cityName} technicians arrive with digital laser meters & genuine SS-316 samples within 24 hours.
          </p>
        </div>
        <div class="flex-shrink-0 w-full sm:w-auto">
          <a
            href={`/contact?city=${slug}`}
            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-[#7CFF3A] text-black font-extrabold text-sm hover:bg-[#68e028] transition-all shadow-[0_10px_25px_rgba(124,255,58,0.3)] hover:-translate-y-0.5"
          >
            <span>Book Free Site Visit in {cityName}</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </section>

    {/* LUXURY FOOTER WITH PERSONAL & COMPANY DETAILS */}
    <Footer />
  </main>
</Layout>
