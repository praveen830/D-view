---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { ALL_LOCATIONS } from '../../data/locations';
---

<Layout
  title="Find D-VIEW Safety Solutions Near You | 7 Andhra Pradesh Hubs"
  description="Select your city to explore certified SS-316 invisible safety grill engineering tailored for Visakhapatnam, Kakinada, Rajahmundry, Vijayawada, Guntur, Nellore & Ongole."
  canonicalUrl="https://dviewsolutions.com/locations"
>
  <Navbar client:load />

  <main class="pt-28 pb-20 bg-[#0B0D0C] min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Header */}
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
          <span>Andhra Pradesh Regional Safety Network</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
          Find D-VIEW Safety <br />
          <span class="text-[#7CFF3A]">Solutions Near You</span>
        </h1>
        <p class="mt-4 text-base sm:text-xl text-[#C7CDD1] leading-relaxed">
          Explore safety solutions designed around your city, property and lifestyle. Each hub provides climate-specific wire engineering, local laser measurements, and direct technician support.
        </p>
      </div>

      {/* 6 Location Hub Cards */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {ALL_LOCATIONS.map((loc) => (
          <a
            href={`/locations/${loc.slug}`}
            class="group bg-[#121816] rounded-3xl border border-[#24322B] overflow-hidden hover:border-[#7CFF3A] transition-all duration-300 flex flex-col justify-between shadow-2xl hover:-translate-y-1.5"
          >
            <div>
              {/* Image Frame */}
              <div class="relative h-60 overflow-hidden">
                <img
                  src={loc.heroImage}
                  alt={`D-VIEW Invisible Grills ${loc.name}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-90"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#121816] via-transparent to-transparent"></div>
                <div class="absolute top-4 left-4 bg-[#0B0D0C]/85 backdrop-blur-md px-3 py-1 rounded-full border border-[#24322B] text-xs font-bold text-[#7CFF3A]">
                  {loc.badge.split(' • ')[1] || 'SAFETY HUB'}
                </div>
                <div class="absolute bottom-3 left-4 text-xs font-semibold text-[#94A3B8]">
                  {loc.district} District
                </div>
              </div>

              {/* Body */}
              <div class="p-6">
                <div class="flex items-center justify-between mb-2">
                  <h2 class="text-2xl font-black text-white group-hover:text-[#7CFF3A] transition-colors">
                    {loc.name}
                  </h2>
                  <span class="text-xs font-bold text-[#7CFF3A] bg-[#1A2420] px-2.5 py-1 rounded-lg border border-[#7CFF3A]/20">
                    SS-316
                  </span>
                </div>

                <p class="text-xs text-[#C7CDD1] leading-relaxed mb-5 line-clamp-2">
                  {loc.heroSubhead}
                </p>

                {/* Key Local Areas Served */}
                <div class="pt-4 border-t border-[#24322B]">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-[#94A3B8] block mb-2">
                    Key Localities Served:
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {loc.areas.slice(0, 4).map((area) => (
                      <span class="text-[11px] bg-[#151C19] text-[#E2E8F0] px-2.5 py-1 rounded-md border border-[#24322B]">
                        {area.name}
                      </span>
                    ))}
                    {loc.areas.length > 4 && (
                      <span class="text-[11px] bg-[#151C19] text-[#7CFF3A] px-2 py-1 rounded-md border border-[#24322B]">
                        +{loc.areas.length - 4} more
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </div>

            {/* CTA Footer */}
            <div class="p-6 pt-0">
              <div class="w-full py-3 rounded-xl bg-[#1A2420] text-xs font-extrabold text-white group-hover:bg-[#7CFF3A] group-hover:text-[#0B0D0C] transition-colors flex items-center justify-center gap-2">
                <span>Explore {loc.name} Hub</span>
                <span>→</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      {/* Free Site Visit Callout */}
      <div class="mt-16 bg-gradient-to-r from-[#151C19] via-[#1A2420] to-[#151C19] rounded-3xl border border-[#24322B] p-8 sm:p-12 text-center max-w-4xl mx-auto shadow-2xl">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-3">
          Need a Custom Multi-Balcony Consultation?
        </h3>
        <p class="text-sm text-[#C7CDD1] mb-6 max-w-xl mx-auto">
          Our central Andhra Pradesh engineering team will connect you with your city's senior technician within 2 hours.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="tel:+919494328999"
            class="px-8 py-3.5 rounded-xl font-extrabold text-sm text-[#0B0D0C] bg-[#7CFF3A] hover:bg-[#8FFF52] transition-colors"
          >
            Call Helpline: +91 94943 28999
          </a>
          <a
            href="https://wa.me/919494328999"
            target="_blank"
            rel="noopener noreferrer"
            class="px-7 py-3.5 rounded-xl font-bold text-sm text-white bg-[#151C19] border border-[#24322B] hover:border-[#7CFF3A]/50 transition-colors"
          >
            WhatsApp Instant Inquiry
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
