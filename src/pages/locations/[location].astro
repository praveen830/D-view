---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Hero from '../../components/Hero.astro';
import PriceCalculator from '../../components/PriceCalculator';
import ProblemSolutionGrid from '../../components/ProblemSolutionGrid.astro';
import TechnicalGuide from '../../components/TechnicalGuide.astro';
import MaterialSection from '../../components/MaterialSection.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FormulaSection from '../../components/FormulaSection.astro';
import AreasServed from '../../components/AreasServed.astro';
import LandmarkSection from '../../components/LandmarkSection.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import ProjectsGrid from '../../components/ProjectsGrid.astro';
import WhyDView from '../../components/WhyDView.astro';
import FaqAccordion from '../../components/FaqAccordion';
import SiteVisitForm from '../../components/SiteVisitForm';
import DynamicQRCode from '../../components/DynamicQRCode';
import OtherLocations from '../../components/OtherLocations.astro';
import Footer from '../../components/Footer.astro';

import { ALL_LOCATIONS, getLocationBySlug, type LocationData } from '../../data/locations';

export async function getStaticPaths() {
  const paths = ALL_LOCATIONS.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc }
  }));
  // Alias /locations/vizag directly to Visakhapatnam
  const vizagData = ALL_LOCATIONS.find(l => l.slug === 'visakhapatnam');
  if (vizagData) {
    paths.push({
      params: { location: 'vizag' },
      props: { location: vizagData }
    });
  }
  return paths;
}

interface Props {
  location: LocationData;
}

const { location } = Astro.props;
---

<Layout
  title={location.seoTitle}
  description={location.seoDescription}
  canonicalUrl={`https://dviewsolutions.in/locations/${location.slug}`}
  cityName={location.name}
  ogImage={location.heroImage}
  keywords={location.keywords}
>
  {/* 1. Navbar with Active Location State */}
  <Navbar client:load currentSlug={location.slug} />

  {/* 2. Hero Section */}
  <Hero location={location} />

  {/* 3 & 4. Interactive Estimated Price Calculator */}
  <PriceCalculator client:load defaultCitySlug={location.slug} cityName={location.name} />

  {/* 5. Problem/Solution Grid */}
  <ProblemSolutionGrid location={location} />

  {/* 6. Local Environment / Technical Guide */}
  <TechnicalGuide location={location} />

  {/* 7. Material & Engineering */}
  <MaterialSection />

  {/* 8. Warranty / Service / Trust & Complimentary Maintenance Kit */}
  <TrustBadges location={location} />

  {/* 9. Our Formula */}
  <FormulaSection />

  {/* 10. Local Areas Served */}
  <AreasServed location={location} />

  {/* 11. Local Landmark / View Section */}
  <LandmarkSection location={location} />

  {/* 12. Services Portfolio */}
  <ServicesGrid location={location} />

  {/* 13. Local Projects */}
  <ProjectsGrid location={location} />

  {/* 14. Why D-VIEW */}
  <WhyDView location={location} />

  {/* 15. FAQ Section */}
  <section id="faq" class="py-20 bg-[#0B0D0C] border-t border-[#24322B] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
          <span>Frequently Answered Questions</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          QUESTIONS ABOUT INVISIBLE GRILLS IN <span class="text-[#7CFF3A]">{location.name.toUpperCase()}</span>
        </h2>
        <p class="mt-4 text-base text-[#C7CDD1]">
          Factual answers regarding balcony safety regulations, installation turnaround, maintenance, and cost.
        </p>
      </div>

      <FaqAccordion client:visible faqs={location.faqs} cityName={location.name} />
    </div>
  </section>

  {/* 16. Book Free Site Visit Lead Capture */}
  <SiteVisitForm client:visible defaultCitySlug={location.slug} cityName={location.name} />

  {/* 17. Location Dynamic QR Code */}
  <section class="py-12 bg-[#0B0D0C] border-t border-[#24322B]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <DynamicQRCode client:visible locationSlug={location.slug} cityName={location.name} />
    </div>
  </section>

  {/* 18. Other Locations Network */}
  <OtherLocations currentSlug={location.slug} />

  {/* 19. Footer */}
  <Footer />
</Layout>
