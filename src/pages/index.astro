---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import LuxuryCitySlider from '../components/LuxuryCitySlider.tsx';
import PriceCalculator from '../components/PriceCalculator';
import ProblemSolutionGrid from '../components/ProblemSolutionGrid.astro';
import MaterialSection from '../components/MaterialSection.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FormulaSection from '../components/FormulaSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import WhyDView from '../components/WhyDView.astro';
import FaqAccordion from '../components/FaqAccordion';
import SiteVisitForm from '../components/SiteVisitForm';
import DynamicQRCode from '../components/DynamicQRCode';
import Footer from '../components/Footer.astro';
import { ALL_LOCATIONS, LOCATIONS_DATA } from '../data/locations';

const defaultLocation = LOCATIONS_DATA['rajahmundry'];

const globalFaqs = [
  {
    question: 'What are invisible grills and how do they work?',
    answer: 'Invisible grills are high-tensile stainless steel (Grade 316) cables spaced at 2 inches (50 mm) intervals, mechanically tensioned and anchored into solid concrete lintels with heavy-duty aluminum tracks. From a short distance, they are nearly invisible against the sky, preserving 99% of your view while preventing falls.'
  },
  {
    question: 'How do invisible grills compare to traditional iron grills?',
    answer: 'Traditional iron grills are bulky, block up to 30% of light, obstruct emergency escape routes, and rust within 2-3 years requiring regular repainting. D-VIEW SS-316 invisible grills never rust, maintain full daylight and cross-ventilation, and comply with luxury apartment association facade guidelines.'
  },
  {
    question: 'Which cities in Andhra Pradesh do you serve?',
    answer: 'We provide direct field measurement and certified installation crews in 6 major hubs: Visakhapatnam, Kakinada, Rajamahendravaram (Rajahmundry), Vijayawada & Amaravati, Guntur, and Nellore.'
  },
  {
    question: 'What wire thickness should I choose?',
    answer: 'For lower floors (1 to 6), 2.0mm or 2.5mm is ideal. For high-rise towers (7+ floors), coastal beach belts (Vizag, Kakinada), and aggressive pigeon zones, our 2.5mm or 3.0mm SS-316 high-tensile cable is strongly recommended.'
  },
  {
    question: 'How much does invisible grill installation cost per square foot?',
    answer: 'Prices typically range between ₹135 to ₹225 per square foot depending on wire thickness (2.0mm, 2.5mm, 3.0mm) and site requirements. Use our interactive calculator on this page for an instant estimate.'
  },
  {
    question: 'What warranty is provided with D-VIEW invisible grills?',
    answer: 'We provide a 5 to 10-year warranty covering material integrity and structural rust prevention for all genuine SS-316 installations.'
  }
];

const locationHighlights = [
  {
    name: 'Visakhapatnam',
    slug: 'vizag',
    headline: 'Unblocked Vizag Views, 101% Breathtaking & Secure',
    sub: 'RK Beach & Kailasagiri Horizon view with certified SS-316 coastal salt shield.',
    image: '/images/visakhapatnam-hero.jpg',
    badge: 'COASTAL LUXURY',
    ctaText: 'Explore Vizag Page'
  },
  {
    name: 'Rajamahendravaram',
    slug: 'rajahmundry',
    headline: 'Safeguarding The River View',
    sub: 'Historic Godavari Arch Bridge & river breeze preservation with pigeon protection.',
    image: '/images/rajahmundry-hero.jpg',
    badge: 'GODAVARI BREEZE',
    ctaText: 'Explore Rajahmundry Page'
  },
  {
    name: 'Vijayawada & Amaravati',
    slug: 'vijayawada-amaravati',
    headline: 'Modern Living in Amaravati & Krishna River Horizons',
    sub: 'High-rise tower safety for HappyNest clusters and Prakasam Barrage views.',
    image: '/images/vijayawada-hero.jpg',
    badge: 'CAPITAL REGION',
    ctaText: 'Explore Vijayawada Page'
  },
  {
    name: 'Guntur',
    slug: 'guntur',
    headline: 'Guardian of Guntur: Kondaveedu Fort & High-Rise Living',
    sub: 'Modern gated community safety replacing heavy box iron bars on Amaravati Road.',
    image: '/images/guntur-hero.jpg',
    badge: 'MODERN RESIDENTIAL',
    ctaText: 'Explore Guntur Page'
  },
  {
    name: 'Kakinada',
    slug: 'kakinada',
    headline: "Kakinada's Coastal Charm & Marine Grade SS-316 Safety",
    sub: 'Port corridor and Vakalapudi lighthouse vistas with anti-saline wire protection.',
    image: '/images/kakinada-hero.jpg',
    badge: 'PORT CORRIDOR',
    ctaText: 'Explore Kakinada Page'
  },
  {
    name: 'Nellore',
    slug: 'nellore',
    headline: 'Tranquility & Trust: Nellore Barrage & Penna River View',
    sub: 'River-facing balcony ventilation and child/elder safety across Magunta Layout.',
    image: '/images/nellore-hero.jpg',
    badge: 'PENNA WATERFRONT',
    ctaText: 'Explore Nellore Page'
  }
];
---

<Layout
  title="D-VIEW Solutions | Premium Invisible Grills & Balcony Safety in Andhra Pradesh"
  description="Certified SS-316 marine-grade invisible grills and balcony safety solutions across Visakhapatnam, Kakinada, Rajahmundry, Vijayawada, Guntur & Nellore. Free site measurements."
  canonicalUrl="https://dviewsolutions.in"
  cityName="Andhra Pradesh"
  ogImage="/images/rajahmundry-hero.jpg"
>
  <Navbar client:load />

  {/* Full-Screen 100vh Visual Multi-City Slider (Invisprotect-Inspired Ultra-Luxury Experience) */}
  <LuxuryCitySlider client:load />

  {/* 4 Architectural Reference Showcase Cards (Invisprotect-Inspired Luxury Showcase) */}
  <section class="py-16 bg-[#080A09] border-t border-[#24322B] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-[#7CFF3A] block mb-2">
            Architectural Safety Portfolio
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight">
            SAFETY WITHOUT BLOCKING <span class="text-[#7CFF3A]">THE VIEW</span>
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-[#94A3B8] max-w-md mt-2 md:mt-0">
          Scroll through our premier coastal, riverfront, and high-rise installations across Andhra Pradesh. Click any hub for local engineering guides.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        {/* Card 1: Visakhapatnam - The Invisible Threshold */}
        <a 
          href="/locations/visakhapatnam"
          class="group relative h-96 rounded-2xl overflow-hidden border border-[#24322B] hover:border-[#7CFF3A] transition-all duration-300 flex flex-col justify-end p-6 shadow-2xl hover:-translate-y-1"
        >
          <img 
            src="/images/visakhapatnam-hero.jpg" 
            alt="Visakhapatnam Invisible Grills - RK Beach & Kailasagiri View" 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-75"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B0D0C] via-[#0B0D0C]/40 to-transparent"></div>
          <div class="relative z-10 space-y-2">
            <span class="inline-block text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-1 rounded bg-[#7CFF3A] text-[#0B0D0C]">
              FEATURED HUB • VIZAG
            </span>
            <span class="block text-xs text-[#7CFF3A] font-bold tracking-wider uppercase">
              The Invisible Threshold
            </span>
            <h3 class="text-xl font-black text-white group-hover:text-[#7CFF3A] transition-colors leading-tight">
              Visakhapatnam Coastal Penthouse
            </h3>
            <p class="text-xs text-[#C7CDD1] line-clamp-2">
              Unblocked RK Beach & Kailasagiri horizon views with SS-316 marine-grade salt-air shielding.
            </p>
            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#7CFF3A] pt-1">
              <span>Explore Vizag Hub</span>
              <span>→</span>
            </span>
          </div>
        </a>

        {/* Card 2: Precision Installation Craftsmanship */}
        <a 
          href="/about"
          class="group relative h-96 rounded-2xl overflow-hidden border border-[#24322B] hover:border-[#7CFF3A] transition-all duration-300 flex flex-col justify-end p-6 shadow-2xl hover:-translate-y-1"
        >
          <img 
            src="/images/wire-engineering.jpg" 
            alt="Precision SS-316 Installation Craftsmanship" 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-75"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B0D0C] via-[#0B0D0C]/40 to-transparent"></div>
          <div class="relative z-10 space-y-2">
            <span class="inline-block text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-1 rounded bg-[#1A2420] text-[#7CFF3A] border border-[#7CFF3A]/30">
              ENGINEERING CRAFT
            </span>
            <span class="block text-xs text-[#7CFF3A] font-bold tracking-wider uppercase">
              Certified Installation
            </span>
            <h3 class="text-xl font-black text-white group-hover:text-[#7CFF3A] transition-colors leading-tight">
              SS-316 Marine Hardware
            </h3>
            <p class="text-xs text-[#C7CDD1] line-clamp-2">
              Multi-strand high-tensile wire rope anchored in 6063-T6 aluminum tracks at &gt;400 kgf breaking load.
            </p>
            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#7CFF3A] pt-1">
              <span>View Hardware Specs</span>
              <span>→</span>
            </span>
          </div>
        </a>

        {/* Card 3: Core Safety Nets - The Weightless Embrace */}
        <a 
          href="/solutions"
          class="group relative h-96 rounded-2xl overflow-hidden border border-[#24322B] hover:border-[#7CFF3A] transition-all duration-300 flex flex-col justify-end p-6 shadow-2xl hover:-translate-y-1"
        >
          <img 
            src="/images/child-safety-balcony.jpg" 
            alt="Balcony & Children Safety Nets" 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-75"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B0D0C] via-[#0B0D0C]/40 to-transparent"></div>
          <div class="relative z-10 space-y-2">
            <span class="inline-block text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-1 rounded bg-[#1A2420] text-[#7CFF3A] border border-[#7CFF3A]/30">
              CORE SAFETY NETS
            </span>
            <span class="block text-xs text-[#7CFF3A] font-bold tracking-wider uppercase">
              The Weightless Embrace
            </span>
            <h3 class="text-xl font-black text-white group-hover:text-[#7CFF3A] transition-colors leading-tight">
              Children & Pet Containment
            </h3>
            <p class="text-xs text-[#C7CDD1] line-clamp-2">
              High-density UV-stabilized mesh for complete peace of mind across high-elevation balconies.
            </p>
            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#7CFF3A] pt-1">
              <span>Explore Solutions</span>
              <span>→</span>
            </span>
          </div>
        </a>

        {/* Card 4: Rajamahendravaram - Genesis of Serenity */}
        <a 
          href="/locations/rajahmundry"
          class="group relative h-96 rounded-2xl overflow-hidden border border-[#24322B] hover:border-[#7CFF3A] transition-all duration-300 flex flex-col justify-end p-6 shadow-2xl hover:-translate-y-1"
        >
          <img 
            src="/images/rajahmundry-hero.jpg" 
            alt="Rajahmundry Godavari River View Invisible Grills" 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-75"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B0D0C] via-[#0B0D0C]/40 to-transparent"></div>
          <div class="relative z-10 space-y-2">
            <span class="inline-block text-[10px] font-extrabold uppercase tracking-widest px-2.5 py-1 rounded bg-[#1A2420] text-[#7CFF3A] border border-[#7CFF3A]/30">
              GODAVARI HUB
            </span>
            <span class="block text-xs text-[#7CFF3A] font-bold tracking-wider uppercase">
              Genesis of Serenity
            </span>
            <h3 class="text-xl font-black text-white group-hover:text-[#7CFF3A] transition-colors leading-tight">
              Godavari Arch Bridge Horizon
            </h3>
            <p class="text-xs text-[#C7CDD1] line-clamp-2">
              Preserving peaceful evening river breezes while safeguarding children and excluding pigeons.
            </p>
            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#7CFF3A] pt-1">
              <span>Explore Rajahmundry</span>
              <span>→</span>
            </span>
          </div>
        </a>

      </div>

    </div>
  </section>

  {/* Interactive Calculator */}
  <PriceCalculator client:load defaultCitySlug="visakhapatnam" cityName="Andhra Pradesh" />

  {/* 6 City Hubs Showcase Grid */}
  <section class="py-20 bg-[#0F1412] border-t border-[#24322B] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
          <span>Hyper-Localized Safety Hubs</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          DISCOVER D-VIEW IN <br />
          <span class="text-[#7CFF3A]">YOUR MAJOR AP CITY</span>
        </h2>
        <p class="mt-4 text-base sm:text-lg text-[#C7CDD1]">
          Every city in Andhra Pradesh faces distinct climate conditions—from Bay of Bengal salt chloride winds in Visakhapatnam to Godavari river humidity in Rajahmundry.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {locationHighlights.map((loc) => (
          <a
            href={`/locations/${loc.slug}`}
            class="group bg-[#121816] rounded-3xl border border-[#24322B] overflow-hidden hover:border-[#7CFF3A] transition-all duration-300 flex flex-col justify-between shadow-xl hover:-translate-y-1.5"
          >
            <div>
              <div class="relative h-56 overflow-hidden">
                <img
                  src={loc.image}
                  alt={loc.headline}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-90"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#121816] via-transparent to-transparent"></div>
                <div class="absolute top-4 left-4 bg-[#0B0D0C]/80 backdrop-blur-md px-3 py-1 rounded-full border border-[#24322B] text-xs font-bold text-[#7CFF3A]">
                  {loc.badge}
                </div>
              </div>

              <div class="p-6">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-xl font-black text-white group-hover:text-[#7CFF3A] transition-colors">
                    {loc.name}
                  </h3>
                  <span class="text-xs text-[#7CFF3A] font-bold">SS-316</span>
                </div>
                <span class="block text-xs font-extrabold text-[#E2E8F0] mb-2 leading-snug">
                  {loc.headline}
                </span>
                <p class="text-xs text-[#94A3B8] leading-relaxed line-clamp-2">
                  {loc.sub}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0">
              <div class="w-full py-2.5 rounded-xl bg-[#1A2420] text-xs font-extrabold text-white group-hover:bg-[#7CFF3A] group-hover:text-[#0B0D0C] transition-colors text-center flex items-center justify-center gap-1.5">
                <span>{loc.ctaText}</span>
                <span>→</span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  {/* Problem-Solution Grid */}
  <ProblemSolutionGrid location={defaultLocation} />

  {/* Engineering Hardware Specs */}
  <MaterialSection />

  {/* Trust & Maintenance Kit */}
  <TrustBadges location={defaultLocation} />

  {/* Conversion Formula */}
  <FormulaSection />

  {/* Services Portfolio */}
  <ServicesGrid location={defaultLocation} />

  {/* Why D-VIEW */}
  <WhyDView location={defaultLocation} />

  {/* FAQ */}
  <section id="faq" class="py-20 bg-[#0B0D0C] border-t border-[#24322B] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
          <span>Expert Answers</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          FREQUENTLY ASKED <span class="text-[#7CFF3A]">QUESTIONS</span>
        </h2>
        <p class="mt-4 text-base text-[#C7CDD1]">
          Learn about our certified SS-316 materials, building society permissions, installation timelines, and warranty terms.
        </p>
      </div>

      <FaqAccordion client:visible faqs={globalFaqs} cityName="Andhra Pradesh" />
    </div>
  </section>

  {/* Book Site Visit Form */}
  <SiteVisitForm client:visible defaultCitySlug="rajahmundry" cityName="Andhra Pradesh" />

  {/* Dynamic Brand QR Code */}
  <section class="py-12 bg-[#0B0D0C] border-t border-[#24322B]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <DynamicQRCode client:visible locationSlug="rajahmundry" cityName="Andhra Pradesh" />
    </div>
  </section>

  <Footer />
</Layout>
