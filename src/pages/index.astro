---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import PriceCalculator from '../components/PriceCalculator';
import ProblemSolutionGrid from '../components/ProblemSolutionGrid.astro';
import MaterialSection from '../components/MaterialSection.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FormulaSection from '../components/FormulaSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import WhyDView from '../components/WhyDView.astro';
import FaqAccordion from '../components/FaqAccordion';
import SiteVisitForm from '../components/SiteVisitForm';
import DynamicQRCode from '../components/DynamicQRCode';
import Footer from '../components/Footer.astro';
import { ALL_LOCATIONS, LOCATIONS_DATA } from '../data/locations';

const defaultLocation = LOCATIONS_DATA['rajahmundry'];

const globalFaqs = [
  {
    question: 'What are invisible grills and how do they work?',
    answer: 'Invisible grills are high-tensile stainless steel (Grade 316) cables spaced at 2 inches (50 mm) intervals, mechanically tensioned and anchored into solid concrete lintels with heavy-duty aluminum tracks. From a short distance, they are nearly invisible against the sky, preserving 99% of your view while preventing falls.'
  },
  {
    question: 'How do invisible grills compare to traditional iron grills?',
    answer: 'Traditional iron grills are bulky, block up to 30% of light, obstruct emergency escape routes, and rust within 2-3 years requiring regular repainting. D-VIEW SS-316 invisible grills never rust, maintain full daylight and cross-ventilation, and comply with luxury apartment association facade guidelines.'
  },
  {
    question: 'Which cities in Andhra Pradesh do you serve?',
    answer: 'We provide direct field measurement and certified installation crews in 6 major hubs: Visakhapatnam, Kakinada, Rajamahendravaram (Rajahmundry), Vijayawada & Amaravati, Guntur, and Nellore.'
  },
  {
    question: 'What wire thickness should I choose?',
    answer: 'For lower floors (1 to 6), 2.0mm or 2.5mm is ideal. For high-rise towers (7+ floors), coastal beach belts (Vizag, Kakinada), and aggressive pigeon zones, our 2.5mm or 3.0mm SS-316 high-tensile cable is strongly recommended.'
  },
  {
    question: 'How much does invisible grill installation cost per square foot?',
    answer: 'Prices typically range between ₹135 to ₹225 per square foot depending on wire thickness (2.0mm, 2.5mm, 3.0mm) and site requirements. Use our interactive calculator on this page for an instant estimate.'
  },
  {
    question: 'What warranty is provided with D-VIEW invisible grills?',
    answer: 'We provide a 5 to 10-year warranty covering material integrity and structural rust prevention for all genuine SS-316 installations.'
  }
];
---

<Layout
  title="D-VIEW Solutions | Premium Invisible Grills & Balcony Safety in Andhra Pradesh"
  description="Certified SS-316 marine-grade invisible grills and balcony safety solutions across Visakhapatnam, Kakinada, Rajahmundry, Vijayawada, Guntur & Nellore. Free site measurements."
  canonicalUrl="https://dviewsolutions.in"
  cityName="Andhra Pradesh"
  ogImage="/images/rajahmundry-hero.jpg"
>
  <Navbar client:load />

  {/* Master Portal Hero */}
  <section class="relative min-h-[95vh] flex items-center pt-28 pb-16 overflow-hidden">
    
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/rajahmundry-hero.jpg" 
        alt="D-VIEW Solutions Premium Invisible Grills Andhra Pradesh" 
        class="w-full h-full object-cover filter brightness-[0.7] contrast-[1.05]"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0B0D0C]/95 via-[#0B0D0C]/80 to-[#0B0D0C]/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0B0D0C] via-transparent to-[#0B0D0C]/40"></div>
      <div class="absolute inset-0 wire-grid-overlay opacity-25 pointer-events-none"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8">
      <div class="max-w-3xl">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#121816]/90 border border-[#7CFF3A]/40 backdrop-blur-md mb-6 shadow-lg">
          <span class="w-2 h-2 rounded-full bg-[#7CFF3A] animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-[#7CFF3A]">
            Andhra Pradesh • 6 Regional City Hubs
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.08] mb-6">
          PREMIUM INVISIBLE GRILLS <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#7CFF3A] via-[#A6FF7A] to-white">
            SAFETY WITHOUT LOSING THE VIEW
          </span>
        </h1>

        <p class="text-lg sm:text-xl text-[#E2E8F0] font-normal leading-relaxed mb-8 max-w-2xl">
          Engineered SS-316 marine-grade invisible safety grills for luxury apartments, penthouses, and gated communities. Certified fall protection for children and pets without blocking coastal, riverfront, or urban skyline vistas.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-10">
          <a 
            href="#calculator" 
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-extrabold text-[#0B0D0C] bg-[#7CFF3A] hover:bg-[#8FFF52] transition-all shadow-[0_0_30px_rgba(124,255,58,0.3)] hover:-translate-y-0.5 active:translate-y-0 text-center"
          >
            <span>CALCULATE ESTIMATE</span>
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href="/locations" 
            class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-bold text-white bg-[#151C19]/80 hover:bg-[#1A2420] border border-[#24322B] hover:border-[#7CFF3A]/60 backdrop-blur-md transition-all text-center"
          >
            <span>EXPLORE 6 CITY HUBS</span>
            <svg class="w-4 h-4 text-[#7CFF3A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        {/* 6 Quick City Chips */}
        <div class="pt-6 border-t border-[#24322B]/80">
          <span class="block text-xs font-bold uppercase tracking-wider text-[#94A3B8] mb-3">
            Select Your City for Local Engineering Specs:
          </span>
          <div class="flex flex-wrap gap-2">
            {ALL_LOCATIONS.map((loc) => (
              <a
                href={`/locations/${loc.slug}`}
                class="px-3.5 py-1.5 rounded-lg bg-[#121816]/90 border border-[#24322B] hover:border-[#7CFF3A] hover:text-[#7CFF3A] text-xs font-semibold text-[#E2E8F0] transition-colors flex items-center gap-1.5"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-[#7CFF3A]"></span>
                <span>{loc.name}</span>
              </a>
            ))}
          </div>
        </div>

      </div>
    </div>

  </section>

  {/* Interactive Calculator */}
  <PriceCalculator client:load defaultCitySlug="rajahmundry" cityName="Andhra Pradesh" />

  {/* 6 City Hubs Showcase Grid */}
  <section class="py-20 bg-[#0F1412] border-t border-[#24322B] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
          <span>Hyper-Localized Safety Hubs</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          DISCOVER D-VIEW IN <br />
          <span class="text-[#7CFF3A]">YOUR MAJOR AP CITY</span>
        </h2>
        <p class="mt-4 text-base sm:text-lg text-[#C7CDD1]">
          Every city in Andhra Pradesh faces distinct climate conditions—from Bay of Bengal salt chloride winds in Visakhapatnam to Godavari river humidity in Rajahmundry.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {ALL_LOCATIONS.map((loc) => (
          <a
            href={`/locations/${loc.slug}`}
            class="group bg-[#121816] rounded-3xl border border-[#24322B] overflow-hidden hover:border-[#7CFF3A] transition-all duration-300 flex flex-col justify-between shadow-xl hover:-translate-y-1.5"
          >
            <div>
              <div class="relative h-56 overflow-hidden">
                <img
                  src={loc.heroImage}
                  alt={loc.heroHeadline}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-90"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#121816] via-transparent to-transparent"></div>
                <div class="absolute top-4 left-4 bg-[#0B0D0C]/80 backdrop-blur-md px-3 py-1 rounded-full border border-[#24322B] text-xs font-bold text-[#7CFF3A]">
                  {loc.badge.split(' • ')[1]}
                </div>
              </div>

              <div class="p-6">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-2xl font-black text-white group-hover:text-[#7CFF3A] transition-colors">
                    {loc.name}
                  </h3>
                  <span class="text-xs text-[#94A3B8] font-medium">{loc.district}</span>
                </div>
                <p class="text-xs text-[#C7CDD1] leading-relaxed line-clamp-2 mb-4">
                  {loc.heroSubhead}
                </p>
                <div class="text-[11px] text-[#7CFF3A] font-medium">
                  {loc.areas.slice(0, 3).map(a => a.name).join(' • ')} + more
                </div>
              </div>
            </div>

            <div class="p-6 pt-0">
              <div class="w-full py-2.5 rounded-xl bg-[#1A2420] text-xs font-extrabold text-white group-hover:bg-[#7CFF3A] group-hover:text-[#0B0D0C] transition-colors text-center">
                Explore {loc.name} Guide →
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  {/* Problem-Solution Grid */}
  <ProblemSolutionGrid location={defaultLocation} />

  {/* Engineering Hardware Specs */}
  <MaterialSection />

  {/* Trust & Maintenance Kit */}
  <TrustBadges location={defaultLocation} />

  {/* Conversion Formula */}
  <FormulaSection />

  {/* Services Portfolio */}
  <ServicesGrid location={defaultLocation} />

  {/* Why D-VIEW */}
  <WhyDView location={defaultLocation} />

  {/* FAQ */}
  <section id="faq" class="py-20 bg-[#0B0D0C] border-t border-[#24322B] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#151C19] border border-[#7CFF3A]/30 text-xs font-semibold text-[#7CFF3A] uppercase tracking-wider mb-4">
          <span>Expert Answers</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          FREQUENTLY ASKED <span class="text-[#7CFF3A]">QUESTIONS</span>
        </h2>
        <p class="mt-4 text-base text-[#C7CDD1]">
          Learn about our certified SS-316 materials, building society permissions, installation timelines, and warranty terms.
        </p>
      </div>

      <FaqAccordion client:visible faqs={globalFaqs} cityName="Andhra Pradesh" />
    </div>
  </section>

  {/* Book Site Visit Form */}
  <SiteVisitForm client:visible defaultCitySlug="rajahmundry" cityName="Andhra Pradesh" />

  {/* Dynamic Brand QR Code */}
  <section class="py-12 bg-[#0B0D0C] border-t border-[#24322B]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <DynamicQRCode client:visible locationSlug="rajahmundry" cityName="Andhra Pradesh" />
    </div>
  </section>

  <Footer />
</Layout>
